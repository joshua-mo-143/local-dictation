[Unit]
Description=Local dictation speech-to-text server
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=CUDA_CACHE_PATH=%t/local-dictation/cuda-cache
Environment=HF_HOME=%h/.cache/huggingface
Environment=TMPDIR=%t/local-dictation
WorkingDirectory=%h/local-dictation
ExecStart=%h/local-dictation/.venv-service/bin/local-dictation-server
RuntimeDirectory=local-dictation
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
CacheDirectory=huggingface
CacheDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
TasksMax=512
LimitNOFILE=4096
LimitCORE=0
MemoryHigh=4G
MemoryMax=6G
MemorySwapMax=infinity
OOMPolicy=stop
OOMScoreAdjust=200
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=default.target
